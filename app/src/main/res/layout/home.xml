<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"

    android:fitsSystemWindows="true"
    tools:context=".Home">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tv_home_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="32sp"
                    android:textColor="@android:color/black"
                    android:fontFamily="@font/notosansbold" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wednesday, Oct 22"
                    android:textSize="14sp"
                    android:fontFamily="@font/notosansregular" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_refresh"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp" />

            <FrameLayout
                android:id="@+id/fl_notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/iv_refresh"
                android:layout_centerVertical="true">

                <ImageView
                    android:id="@+id/iv_notification_bell"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_notification_bell" />

                <TextView
                    android:id="@+id/tv_notification_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:text="1"
                    android:background="@drawable/notification_badge_background"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:fontFamily="@font/notosansmedium" />
            </FrameLayout>
        </RelativeLayout>


        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="16dp">


            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorSurfaceVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_peso_sign"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Sales"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />

                    <TextView
                        android:id="@+id/tv_sales_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorLightPink">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_shopping_cart"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orders"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />

                    <TextView
                        android:id="@+id/tv_orders_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorMintGreen">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_product_box"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Products"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />

                    <TextView
                        android:id="@+id/tv_products_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorLightBlue">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_low_stock_graph"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low Stock"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />

                    <TextView
                        android:id="@+id/tv_low_stock_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top Products"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/notosanssemibold"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/white">

            <TextView
                android:id="@+id/tv_no_sales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No sales yet today"
                android:gravity="center"
                android:padding="48dp"
                android:textSize="16sp"
                android:fontFamily="@font/notosansregular"
                android:textColor="#666666"/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>