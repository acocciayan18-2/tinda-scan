<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".Home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tv_home_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_home"
                    android:textSize="32sp"
                    android:textColor="@android:color/black"
                    android:fontFamily="@font/notosansbold" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wednesday, Oct 22"
                    android:textSize="14sp"
                    android:fontFamily="@font/notosansregular" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                app:tint="@android:color/black"
                android:contentDescription="@string/content_desc_refresh" />

            <FrameLayout
                android:id="@+id/fl_notification"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_toStartOf="@id/iv_refresh"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_notifications">

                <ImageView
                    android:id="@+id/iv_notification_bell"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification_bell"
                    app:tint="@android:color/black"/>

                <TextView
                    android:id="@+id/tv_notification_badge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="1"
                    android:background="@drawable/notification_badge_background"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:gravity="center"
                    android:fontFamily="@font/notosansmedium"
                    android:visibility="gone"/>
            </FrameLayout>

        </RelativeLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorSurfaceVariant">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_peso_sign"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_todays_profit"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />
                    <TextView
                        android:id="@+id/tv_profit_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_currency_value"
                        tools:text="₱0"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorLightPink">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_shopping_cart"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_todays_sales"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />
                    <TextView
                        android:id="@+id/tv_sales_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_currency_value"
                        tools:text="₱0"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorMintGreen">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_product_box"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_products"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />
                    <TextView
                        android:id="@+id/tv_products_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_count_value"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/BaseCardStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/bgColorLightBlue">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_low_stock_graph"
                        app:tint="@color/primaryColor"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_low_stock"
                        android:textColor="@color/secondaryColor"
                        android:fontFamily="@font/notosansmedium" />
                    <TextView
                        android:id="@+id/tv_low_stock_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_count_value"
                        android:textColor="@color/primaryColor"
                        android:textSize="24sp"
                        android:fontFamily="@font/notosansbold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_recent_activity"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/notosanssemibold"
                android:layout_centerVertical="true"/>

            <ImageButton
                android:id="@+id/btn_clear_activities"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_trash_stroke"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#666666"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:tooltipText="@string/tooltip_clear_logs"
                android:contentDescription="@string/tooltip_clear_logs"/>
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_activities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_recent_activity"
            tools:itemCount="3"/>

        <TextView
            android:id="@+id/tv_no_activities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_no_recent_activities"
            android:gravity="center"
            android:padding="32dp"
            android:textSize="14sp"
            android:textColor="#999999"
            android:fontFamily="@font/notosansregular"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>