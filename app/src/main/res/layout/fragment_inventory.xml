<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F7F8FA">

    <!-- TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Product Inventory"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- ADD PRODUCT & FILTER BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_add_product"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Add Product"
            android:background="#2E7D32"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_filter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Filter"
            android:background="#EEEEEE"
            android:textColor="#000000"
            android:textSize="16sp"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- SEARCH BAR -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Search products..."
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:background="@android:color/transparent"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- PRODUCT LIST -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Item 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 1 - ₱100 - Quantity: 5"
            android:textSize="18sp"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- Item 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 2 - ₱250 - Quantity: 10"
            android:textSize="18sp"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- Item 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 3 - ₱500 - Quantity: 3"
            android:textSize="18sp"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- Item 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 4 - ₱1,000 - Quantity: 7"
            android:textSize="18sp"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- Item 5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 5 - ₱750 - Quantity: 2"
            android:textSize="18sp"
            android:textColor="#000000"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>

</LinearLayout>
