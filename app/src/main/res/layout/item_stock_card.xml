<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"  android:layout_toStartOf="@id/tv_stock_count"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"> <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Coffee Beans"
                android:textColor="@color/primaryColor"
                android:textSize="16sp"
                android:fontFamily="@font/notosanssemibold" />

                <TextView
                    android:id="@+id/tv_product_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beverages"
                    android:textColor="@color/secondaryColor"
                    android:textSize="13sp"
                    android:fontFamily="@font/notosansregular" />

                <TextView
                    android:id="@+id/tv_product_expiration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:textColor="@color/black"
                android:textSize="12sp"
                android:fontFamily="@font/notosansregular" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_stock_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45"
                android:textColor="@color/white"
                android:fontFamily="@font/notosanssemibold"
                android:background="@drawable/stock_badge_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textSize="12sp"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:textColor="@color/secondaryColor"
                    android:textSize="12sp"
                    android:fontFamily="@font/notosansregular" />

                <TextView
                    android:id="@+id/tv_product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P12.99"
                    android:textColor="#00943F"
                    android:textSize="16sp"
                    android:fontFamily="@font/notosanssemibold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barcode"
                    android:textColor="@color/secondaryColor"
                    android:textSize="12sp"
                    android:fontFamily="@font/notosansregular" />

                <TextView
                    android:id="@+id/tv_product_barcode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1234567890123"
                    android:textColor="@color/primaryColor"
                    android:textSize="16sp"
                    android:fontFamily="@font/notosanssemibold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"> <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Delete"
            android:textSize="14sp"
            android:fontFamily="@font/notosanssemibold"
            app:icon="@drawable/ic_trash_stroke"
            app:iconTint="#D32F2F"
            android:textColor="#D32F2F" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Edit"
                android:textSize="14sp"
                android:fontFamily="@font/notosanssemibold"
                app:icon="@drawable/ic_edit"
                app:iconTint="#1976D2" android:textColor="#1976D2" /> </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>