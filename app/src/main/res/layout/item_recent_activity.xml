<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F0F0F0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Icon Background (Color changes dynamically in Adapter) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_icon_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E3F2FD">

            <ImageView
                android:id="@+id/iv_activity_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_history"
                app:tint="@color/primaryColor"
                android:layout_gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Text Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_activity_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity Title"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:fontFamily="@font/notosanssemibold" />

            <TextView
                android:id="@+id/tv_activity_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity Details"
                android:textColor="#666666"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/notosansregular" />
        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tv_activity_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Just now"
            android:textColor="#999999"
            android:textSize="11sp"
            android:fontFamily="@font/notosansregular" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>